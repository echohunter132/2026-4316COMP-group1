import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns


df = pd.read_csv("country_wise_latest.csv")


df["1 week % increase"] = pd.to_numeric(df["1 week % increase"], errors="coerce")


df = df.dropna(subset=["1 week % increase"])


top10 = df.sort_values(
    by="1 week % increase",
    ascending=False
).head(10)


plt.figure(figsize=(12, 6))

sns.barplot(
    data=top10,
    x="1 week % increase",
    y="Country/Region",
    palette="Reds_r"
)

plt.title("Countries with Fastest Growth in Confirmed Cases (1-week % increase)")
plt.xlabel("1 Week % Increase")
plt.ylabel("Country")

plt.tight_layout()
plt.show()
